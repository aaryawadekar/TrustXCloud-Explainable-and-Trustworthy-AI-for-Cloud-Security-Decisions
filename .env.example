# ==============================================================================
# Explainable AWS Cloud Security - Environment Configuration
# ==============================================================================

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
# Note: Google AI Studio offers a free tier for developers with rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AWS Credentials (Optional: required only for live sandbox ingestion / experiment runner)
# If not configured, the pipeline runs in offline reproducible simulation mode.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Database Configuration (Defaults to local SQLite if left empty)
# Example: sqlite:///./data/trustxcloud.db or postgresql://user:pass@localhost:5432/trustxcloud
DATABASE_URL=

# JWT Authentication Configuration
# Provide a 256-bit (32+ character) random secret in production
JWT_SECRET=your-secure-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Google OAuth 2.0 / OpenID Connect (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

