# ==============================================================================
# TrustXCloud - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================================

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Free tier available. When absent, uses local deterministic LLM fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AWS Region
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1

# AWS SQS Queue URL (required for real-time CloudTrail event polling)
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# Leave empty to run in LOCAL mode (no live event ingestion).
AWS_SQS_QUEUE_URL=

# AWS S3 Bucket containing CloudTrail log archives
AWS_S3_CLOUDTRAIL_BUCKET=

# AWS DynamoDB Table for ML decision persistence
DYNAMODB_TABLE_NAME=CloudSecurityDecisions

# TrustXCloud operating mode: LOCAL or AWS
TRUSTXCLOUD_MODE=LOCAL

# Database (defaults to local SQLite if empty)
DATABASE_URL=

# JWT Authentication (use a 32+ char random secret in production)
JWT_SECRET=your-secure-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Google OAuth 2.0 (optional - demo mode used when absent)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000