# ==============================================================================
# Explainable AWS Cloud Security - Environment Configuration
# ==============================================================================

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
# Note: Google AI Studio offers a free tier for developers with rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AWS Credentials (Optional: required only for live sandbox ingestion / experiment runner)
# If not configured, the pipeline runs in offline reproducible simulation mode.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
